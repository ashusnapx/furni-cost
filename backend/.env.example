# Gemini (free tier: Flash-class only — never send raw financial data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER=true

# Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=furnicost-dev
NEO4J_DATABASE=neo4j

# Postgres (LangGraph checkpointer)
POSTGRES_DSN=postgresql://furnicost:furnicost@localhost:5432/furnicost

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
